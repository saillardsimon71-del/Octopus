# Defense in depth only.
# The primary quota boundary is architectural: GPT-6 Astra runs under the
# deterministic parent supervisor and must never start the long worker itself.
# These prefix rules block the common accidental direct paths. They are not
# treated as a complete security sandbox against arbitrary shell indirection.

prefix_rule(
    pattern = ["kilo"],
    decision = "forbidden",
    justification = "Kilo must run only through the external OCTOPUS relay."
)

prefix_rule(
    pattern = ["kilo.cmd"],
    decision = "forbidden",
    justification = "Kilo must run only through the external OCTOPUS relay."
)

prefix_rule(
    pattern = ["python", "-m", "octopus", "night-shift"],
    decision = "forbidden",
    justification = "night-shift must run only through the external OCTOPUS relay."
)

prefix_rule(
    pattern = ["python.exe", "-m", "octopus", "night-shift"],
    decision = "forbidden",
    justification = "night-shift must run only through the external OCTOPUS relay."
)

prefix_rule(
    pattern = ["python3", "-m", "octopus", "night-shift"],
    decision = "forbidden",
    justification = "night-shift must run only through the external OCTOPUS relay."
)

prefix_rule(
    pattern = ["py", "-m", "octopus", "night-shift"],
    decision = "forbidden",
    justification = "night-shift must run only through the external OCTOPUS relay."
)

prefix_rule(
    pattern = ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".\\scripts\\run_external_dev_ticket.ps1"],
    decision = "forbidden",
    justification = "The worker runner is owned by the parent supervisor, not the Astra shell."
)

prefix_rule(
    pattern = ["powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".\\scripts\\run_external_dev_ticket.ps1"],
    decision = "forbidden",
    justification = "The worker runner is owned by the parent supervisor, not the Astra shell."
)
