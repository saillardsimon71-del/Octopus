    },
    "groq/gpt-oss-120b": {
      "provider": "groq", "api_model": "openai/gpt-oss-120b", "cost_class": "free_quota",
      "capabilities": ["json", "tools", "reasoning_effort"],
      "notes": "Apache 2.0. Quota gratuit Groq."
    },
    "groq/qwen3.8-27b": {
      "provider": "groq", "api_model": "qwen/qwen3.8-27b", "cost_class": "free_quota",
      "capabilities": ["json", "vision"],
      "notes": "Apache 2.0. Quota gratuit Groq."
    },
    "gemini/3.5-flash": {
      "provider": "gemini", "api_model": "gemini-3.5-flash", "cost_class": "free_quota",
