{
  "version": 1,
  "_doc": "Catalogue OCTOPUS. Prix en USD par million de tokens, heures creuses ; multiplicateur applique dans les fenetres de pointe du fournisseur. Informations de quotas et de donnees verifiees le 2026-09-16 (sources par fournisseur) : a reverifier avant tout usage commercial.",
  "default_profile": "legacy",
  "budgets": {"daily_usd": 2.0},
  "evidence": {"min_samples": 5, "min_pass_rate": 0.9, "max_age_days": 60},
  "providers": {
    "deepseek": {
      "kind": "cloud",
      "base_url": "https://api.deepseek.com",
      "api_key_env": "DEEPSEEK_API_KEY",
      "timeout_s": 600,
      "max_retries": 2,
      "peak_utc_weekdays": ["01:00-04:00", "06:00-10:00"],
      "data_policy": "Donnees traitees et stockees en Chine ; utilisees par defaut pour entrainer les modeles (opposition par e-mail).",
      "sources": ["https://api-docs.deepseek.com/quick_start/pricing", "https://cdn.deepseek.com/policies/en-US/deepseek-privacy-policy.html"]
    },
    "ollama": {
      "kind": "local",
      "base_url": "http://127.0.0.1:11434/v1",
      "api_key_env": null,
      "timeout_s": 300,
      "max_retries": 0,
      "health_path": "/models",
      "data_policy": "Execution locale : aucune donnee ne quitte la machine.",
      "sources": ["https://docs.ollama.com/api/openai-compatibility", "https://docs.ollama.com/gpu"]
    },
    "lmstudio": {
      "kind": "local",
      "base_url": "http://127.0.0.1:1234/v1",
      "api_key_env": null,
      "timeout_s": 300,
      "max_retries": 0,
      "health_path": "/models",
      "data_policy": "Execution locale. Application gratuite, y compris au travail.",
      "sources": ["https://lmstudio.ai/blog/free-for-work"]
    },
    "groq": {
      "kind": "cloud",
      "base_url": "https://api.groq.com/openai/v1",
      "api_key_env": "GROQ_API_KEY",
      "timeout_s": 60,
      "max_retries": 1,
      "quota_note": "Plan gratuit : 30 requetes/min, 1 000 requetes/jour, 8 000 tokens/min, 200 000 tokens/jour (gpt-oss-120b, qwen3.8-27b).",
      "data_policy": "Entrees et sorties non utilisees pour l'entrainement ; retention jusqu'a 30 jours ; Zero Data Retention activable.",
      "sources": ["https://console.groq.com/docs/rate-limits", "https://console.groq.com/docs/your-data"]
    },
    "gemini": {
      "kind": "cloud",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "api_key_env": "GEMINI_API_KEY",
      "timeout_s": 90,
      "max_retries": 1,
      "quota_note": "Palier gratuit : limites par projet, affichees dans Google AI Studio (non publiees).",
      "data_policy": "Palier gratuit : contenus utilises pour ameliorer les produits, sauf pour les utilisateurs de l'EEE, de Suisse et du Royaume-Uni (conditions du palier payant). Usage professionnel, 18 ans et plus.",
      "sources": ["https://ai.google.dev/gemini-api/docs/pricing", "https://ai.google.dev/gemini-api/terms", "https://ai.google.dev/gemini-api/docs/openai"]
    },
    "openrouter": {
      "kind": "cloud",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "timeout_s": 90,
      "max_retries": 1,
      "quota_note": "Modeles :free : 20 requetes/min ; 50 requetes/jour, 1 000 apres 10 credits achetes au total.",
      "data_policy": "Depend du fournisseur final de chaque modele gratuit : a verifier modele par modele.",
      "sources": ["https://openrouter.ai/docs/api-reference/limits"]
    },
    "cerebras": {
      "kind": "cloud",
      "base_url": "https://api.cerebras.ai/v1",
      "api_key_env": "CEREBRAS_API_KEY",
      "timeout_s": 60,
      "max_retries": 1,
      "quota_note": "Essai gratuit : 5 requetes/min, 1 million de tokens/jour (gpt-oss-120b, qwen-3.8-27b).",
      "data_policy": "Non verifie.",
      "sources": ["https://inference-docs.cerebras.ai/support/rate-limits"]
    },
    "kilo": {
      "kind": "cloud",
      "base_url": "https://api.kilo.ai/api/gateway",
      "api_key_env": "KILO_API_KEY",
      "timeout_s": 90,
      "max_retries": 0,
      "quota_note": "Modeles explicitement suffixes :free uniquement ; disponibilite et quotas susceptibles d'evoluer.",
      "data_policy": "Gateway tiers : appliquer les conditions Kilo et celles du fournisseur d'inference sous-jacent.",
      "sources": ["https://kilo.ai/docs/gateway", "https://kilo.ai/docs/gateway/models-and-providers", "https://kilo.ai/docs/gateway/usage-and-billing"]
    }
  },
  "models": {
    "deepseek/flash": {
      "provider": "deepseek", "api_model": "deepseek-flash", "cost_class": "paid",
