      "price": {"input_cache_hit": 0.003, "input_cache_miss": 0.15, "output": 0.60, "peak_multiplier": 2.0},
      "notes": "DeepSeek-V4.1-Flash. Mode reflexion desactive (sinon il consomme max_tokens)."
