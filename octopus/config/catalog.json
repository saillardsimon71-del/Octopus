{
  "version": 1,
  "_doc": "Catalogue OCTOPUS. Prix en USD par million de tokens, heures creuses ; multiplicateur applique dans les fenetres de pointe du fournisseur. Informations de quotas et de donnees verifiees le 2026-09-16 (sources par fournisseur) : a reverifier avant tout usage commercial.",
  "default_profile": "zero_cost",
  "budgets": {
    "daily_usd": 2.0
  },
  "evidence": {
    "min_samples": 5,
    "min_pass_rate": 0.9,
    "max_age_days": 60
  },
  "providers": {
    "deepseek": {
      "kind": "cloud",
      "base_url": "https://api.deepseek.com",
      "api_key_env": "DEEPSEEK_API_KEY",
      "timeout_s": 600,
      "max_retries": 2,
      "peak_utc_weekdays": ["01:00-04:00", "06:00-10:00"],
      "data_policy": "Donnees traitees et stockees en Chine ; utilisees par defaut pour entrainer les modeles (opposition par e-mail).",
      "sources": ["https://api-docs.deepseek.com/quick_start/pricing", "https://cdn.deepseek.com/policies/en-US/deepseek-privacy-policy.html"]
    },
    "openrouter": {
      "kind": "cloud",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "timeout_s": 90,
      "max_retries": 0,
      "quota_note": "Free-only models verified from API pricing; account quotas remain external and variable.",
      "data_policy": "Depend du fournisseur final de chaque modele gratuit : a verifier modele par modele.",
      "sources": ["https://openrouter.ai/docs/api-reference/limits"]
    }
  },
  "models": {
    "deepseek/flash": {
      "provider": "deepseek",
      "api_model": "deepseek-flash",
      "cost_class": "paid",
      "capabilities": ["json", "vision", "tools"],
      "structured_methods": ["tool_call", "json_object", "text"],
      "params": {
        "extra_body": {
          "thinking": {
            "type": "disabled"
          }
        }
      },
      "price": {
        "input_cache_hit": 0.003,
        "input_cache_miss": 0.15,
        "output": 0.6,
        "peak_multiplier": 2.0
      },
      "notes": "DeepSeek-V4.1-Flash. Mode reflexion desactive (sinon il consomme max_tokens)."
    },
    "deepseek/v4-pro": {
      "provider": "deepseek",
      "api_model": "deepseek-v4-pro",
      "cost_class": "paid",
      "capabilities": ["json", "tools", "reasoning_effort"],
      "params": {
        "extra_body": {
          "thinking": {
            "type": "enabled"
          }
        }
      },
      "price": {
        "input_cache_hit": 0.022,
        "input_cache_miss": 0.66,
        "output": 1.98,
        "peak_multiplier": 2.0
      },
      "notes": "DeepSeek-V4-Pro. Pas de vision."
    }
  },
  "profiles": {
    "legacy": {
      "description": "Comportement historique : le modele impose par le code est utilise tel quel.",
      "honor_pins": true,
      "allowed_cost_classes": ["paid", "free_quota"],
      "require_evidence": false,
      "fallback": false
    },
    "zero_cost": {
      "description": "OpenRouter gratuit uniquement. Aucun appel payant automatique.",
      "honor_pins": false,
      "allowed_cost_classes": ["free_quota"],
      "require_evidence": false,
      "fallback": true
    },
    "low_cost": {
      "description": "OpenRouter gratuit d'abord ; payant seulement si aucune alternative validee, dans le budget.",
      "honor_pins": false,
      "allowed_cost_classes": ["free_quota", "paid"],
      "require_evidence": true,
      "fallback": true
    },
    "economical": {
      "description": "FREE FIRST : deux routes gratuites et trois requetes au plus. Frontiere humaine avant tout appel payant.",
      "honor_pins": false,
      "allowed_cost_classes": ["free_quota"],
      "max_free_attempts": 2,
      "require_evidence": false,
      "fallback": true
    },
    "flash_fallback": {
      "description": "Profil experimental : routes gratuites d'abord, puis uniquement DeepSeek-V4.1-Flash payant sous budget de mission.",
      "honor_pins": false,
      "allowed_cost_classes": ["free_quota", "paid"],
      "require_evidence": false,
      "fallback": true
    },
    "quality_first": {
      "description": "Meilleur modele valide d'abord ; couts suivis et plafonnes.",
      "honor_pins": false,
      "allowed_cost_classes": ["paid", "free_quota"],
      "require_evidence": true,
      "fallback": true
    },
    "bench": {
      "description": "Banc d'evaluation : modele impose, aucune exigence de preuve.",
      "honor_pins": true,
      "allowed_cost_classes": ["paid", "free_quota"],
      "require_evidence": false,
      "fallback": false
    }
  },
