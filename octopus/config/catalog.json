      "price": {"input_cache_hit": 0.022, "input_cache_miss": 0.66, "output": 1.98, "peak_multiplier": 2.0},
      "notes": "DeepSeek-V4-Pro. Pas de vision."
    },
    "ollama/qwen3.5-2b": {
      "provider": "ollama", "api_model": "qwen3.5:2b", "cost_class": "local",
